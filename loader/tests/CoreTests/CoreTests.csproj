<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Beatform.CoreTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The engine-free core is compiled straight from shared/Core. -->
    <Compile Include="..\..\..\shared\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
    <Compile Include="..\..\..\shared\Scripting\*.cs" Link="Scripting\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jint" Version="4.17.0" />
  </ItemGroup>
</Project>
