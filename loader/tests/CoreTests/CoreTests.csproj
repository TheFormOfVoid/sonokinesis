<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Beatform.CoreTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The core is engine-free and is compiled straight from the loader sources. -->
    <Compile Include="..\..\src\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
