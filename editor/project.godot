; Engine configuration file.
config_version=5

[application]

config/name="Sonokinesis Editor"
config/description="Level editor for Sonokinesis custom levels"
run/main_scene="res://Main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/low_processor_mode=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/resizable=true
window/energy_saving/keep_screen_on=false
window/subwindows/embed_subwindows=true

[dotnet]

project/assembly_name="SonokinesisEditor"

[gui]

common/snap_controls_to_pixels=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
environment/defaults/default_clear_color=Color(0.043, 0.051, 0.071, 1)
